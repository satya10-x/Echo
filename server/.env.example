NODE_ENV=development
PORT=5000
# On Render, use the exact Vercel origin (no trailing slash or path).
# CLIENT_ORIGINS takes precedence over CLIENT_URL; include every allowed origin.
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
# Production values for this deployment:
# CLIENT_URL=https://echo-git-main-satyanarayan45x-6966.vercel.app
# CLIENT_ORIGINS=https://echo-git-main-satyanarayan45x-6966.vercel.app
MONGODB_URI=mongodb://127.0.0.1:27017/vibeshift_ai
GROQ_API_KEY=
GROQ_MODEL=
# Set json_schema only for a model supporting Groq strict structured outputs.
GROQ_STRUCTURED_OUTPUT=json_object
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Total generation + evaluation + repair budget; at most one targeted repair.
INTELLIGENCE_TIMEOUT_MS=90000
INTELLIGENCE_MAX_REPAIRS=1
# Minimum fraction of model-identified propositions marked preserved (heuristic).
FIDELITY_MIN_COVERAGE=0.9
